<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_fab_container"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:background="@drawable/bg_fab"
    android:clickable="true"
    android:elevation="8dp"
    android:focusable="true">

    <ImageView
        android:id="@+id/overlay_fab_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center"
        android:contentDescription="Dungeon Save Manager floating button"
        android:scaleType="fitCenter"
        android:src="@mipmap/ic_launcher" />

    <!-- Status indicator badge dot -->
    <View
        android:id="@+id/overlay_fab_status_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_status_pill" />
</FrameLayout>
